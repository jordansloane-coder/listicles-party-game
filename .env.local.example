# Copy this file to .env.local (gitignored) to enable online play in local
# dev. Get these values from your Firebase project's web app config
# (Firebase Console → Project settings → General → Your apps → SDK setup and
# configuration → Config). None of this is secret — it's meant to ship in a
# client bundle; real security comes from the Realtime Database Rules.
#
# For the deployed GitHub Pages build, these same values are set as
# repository Variables (not Secrets) so the build:pages workflow can inject
# them — see .github/workflows/pages.yml and the README section on setting
# up online play.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
